[Unit]
Description=shade-tree bootnode (gateway discovery)
After=network-online.target tor.service
Wants=network-online.target
[Service]
User=shade-tree
WorkingDirectory=/opt/shade-tree
Environment=SHADE_TREE_BOOTNODE_PORT=8877
Environment=SHADE_TREE_BOOTNODE_ADMISSION=open
Environment=SHADE_TREE_BOOTNODE_SIGNER_KEY=/opt/shade-tree/deploy-state/bootnode-signer.key
Environment=SHADE_TREE_BOOTNODE_STORE=/opt/shade-tree/deploy-state/bootnode-state.json
ExecStart=/usr/bin/node /opt/shade-tree/bootnode/server.mjs
Restart=always
RestartSec=3
# --- sandbox (see rationale in bootstrap.sh) ---
NoNewPrivileges=true
UMask=0077
ProtectSystem=strict
ReadWritePaths=/opt/shade-tree/deploy-state
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
Nice=5
CPUAccounting=true
CPUQuota=25%
CPUWeight=25
MemoryAccounting=true
MemoryMax=256M
MemorySwapMax=0
TasksAccounting=true
TasksMax=96
[Install]
WantedBy=multi-user.target
