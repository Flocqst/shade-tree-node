[Unit]
Description=shade-tree gateway heartbeat to bootnode
After=shade-tree-bootnode.service tor.service
[Service]
User=shade-tree
WorkingDirectory=/opt/shade-tree
Environment=SHADE_TREE_BOOTNODE_ONION=bootnodeplaceholderplaceholderplaceholderplaceholderplac.onion
Environment=SHADE_TREE_GW_IDENTITY=/opt/shade-tree/deploy-state/gateway-hs/identity.local.json
Environment=SHADE_TREE_TOR_PORT=9050
Environment=SHADE_TREE_ADMIT=invited
ExecStart=/usr/bin/node /opt/shade-tree/bootnode/heartbeat.mjs
Restart=always
RestartSec=10
# --- sandbox (see rationale in bootstrap.sh) ---
NoNewPrivileges=true
UMask=0077
ProtectSystem=strict
ReadWritePaths=/opt/shade-tree/deploy-state
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
Nice=5
CPUAccounting=true
CPUQuota=20%
CPUWeight=25
MemoryAccounting=true
MemoryMax=256M
MemorySwapMax=0
TasksAccounting=true
TasksMax=96
[Install]
WantedBy=multi-user.target
