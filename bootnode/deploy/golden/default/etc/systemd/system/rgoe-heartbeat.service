[Unit]
Description=rgoe gateway heartbeat to bootnode
After=rgoe-bootnode.service tor.service
[Service]
User=rgoe
WorkingDirectory=/opt/rgoe
Environment=RGOE_BOOTNODE_ONION=bootnodeplaceholderplaceholderplaceholderplaceholderplac.onion
Environment=RGOE_GW_IDENTITY=/opt/rgoe/deploy-state/gateway-hs/identity.local.json
Environment=RGOE_TOR_PORT=9050
ExecStart=/usr/bin/node /opt/rgoe/bootnode/heartbeat.mjs
Restart=always
RestartSec=10
# --- sandbox (see rationale in bootstrap.sh) ---
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/rgoe/deploy-state
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=256
[Install]
WantedBy=multi-user.target
