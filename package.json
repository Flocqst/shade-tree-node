{
  "name": "reputation-gated-onion-egress",
  "version": "0.2.0",
  "description": "A Tor onion-service egress proxy gated by a zero-knowledge proof of membership in a reputation set (Semaphore/RLN), with live gateway discovery via a bootnode.",
  "type": "module",
  "private": true,
  "bin": {
    "rgoe": "bin/rgoe.mjs"
  },
  "scripts": {
    "enroll": "node group/enroll.mjs",
    "gateway": "node gateway/gateway.mjs",
    "shim": "node client/shim.mjs",
    "bootnode": "node bootnode/server.mjs",
    "keygen": "node bootnode/keygen.mjs",
    "heartbeat": "node bootnode/heartbeat.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo": "node demo/server.mjs",
    "test": "node scripts/test-all.mjs",
    "test:node": "node scripts/test-all.mjs --no-contracts",
    "test:contracts": "forge test",
    "coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 60 --functions 63 --branches 78 node scripts/test-all.mjs --no-contracts"
  },
  "dependencies": {
    "@semaphore-protocol/group": "^4.0.0",
    "@semaphore-protocol/identity": "^4.0.0",
    "@semaphore-protocol/proof": "^4.0.0",
    "ethers": "^6.13.4",
    "js-sha3": "^0.8.0",
    "poseidon-lite": "^0.3.0",
    "rlnjs": "^3.3.0",
    "socks": "^2.8.3"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
