# Fires rgoe-uptime-probe.service every 5 minutes (the SLI cadence in docs/SLO.md 2.2/2.3).
# `systemctl list-timers rgoe-uptime-probe.timer` shows the next run;
# `journalctl -u rgoe-uptime-probe.service -n 50` shows the last probe lines.
[Unit]
Description=rgoe fleet uptime probe every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
# Spread a little so a fleet of probers does not hit the bootnode in lockstep.
RandomizedDelaySec=30s
AccuracySec=15s
Persistent=false
Unit=rgoe-uptime-probe.service

[Install]
WantedBy=timers.target
