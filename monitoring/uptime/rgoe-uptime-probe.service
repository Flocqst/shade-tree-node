# rgoe external uptime probe — one-shot unit fired by rgoe-uptime-probe.timer (monitoring/UPTIME.md).
#
# Install on any tor-capable box that is NOT part of the fleet (the point is an OUTSIDE vantage):
#   sudo install -m 0644 monitoring/uptime/rgoe-uptime-probe.{service,timer} /etc/systemd/system/
#   sudo install -m 0600 monitoring/uptime/uptime-probe.env.example /etc/rgoe/uptime-probe.env  # then edit
#   sudo systemctl daemon-reload && sudo systemctl enable --now rgoe-uptime-probe.timer
#
# The probe reads RGOE_BOOTNODE_ONION + RGOE_DIR_SIGNER (or RGOE_NETWORK=<name>, resolved from
# network/<name>/bootnode.json) from the EnvironmentFile; nothing secret lives in it (onion +
# public signer key). Exit code lands in the journal: 0 healthy, 1 (json) / 2 (nagios) unhealthy.
[Unit]
Description=rgoe fleet uptime probe (over Tor, signer-pinned)
Documentation=file:///opt/rgoe/monitoring/UPTIME.md
After=network-online.target tor.service
Wants=network-online.target

[Service]
Type=oneshot
User=rgoe
WorkingDirectory=/opt/rgoe
EnvironmentFile=/etc/rgoe/uptime-probe.env
Environment=RGOE_TOR_HOST=127.0.0.1
Environment=RGOE_TOR_PORT=9050
ExecStart=/usr/bin/node /opt/rgoe/scripts/uptime-probe.mjs --format nagios
# A CRITICAL probe is a signal, not a unit failure storm: keep the exit code in the journal
# (`journalctl -u rgoe-uptime-probe`) but do not mark the unit failed for the timer's sake.
SuccessExitStatus=1 2
TimeoutStartSec=90
# --- sandbox (same posture as bootnode/deploy/bootstrap.sh units) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=64
