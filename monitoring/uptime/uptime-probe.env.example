# /etc/rgoe/uptime-probe.env — EnvironmentFile for rgoe-uptime-probe.service (systemd) and the
# crontab line in monitoring/uptime/crontab.example. Nothing here is secret: a bootnode onion and
# a PUBLIC signer key. Fill in the NEW fleet's values from network/<name>/bootnode.json.
#
# EITHER name the network record (resolved by lib/network-record.mjs; a `pending` record makes the
# probe report misconfig, which is correct — there is nothing to probe yet):
RGOE_NETWORK=sepolia
# OR pin the discovery inputs explicitly (these override the record when both are set):
#RGOE_BOOTNODE_ONION=<56-char>.onion
#RGOE_DIR_SIGNER=<64-hex ed25519 pubkey, no 0x>
#
# Optional:
#RGOE_PROBE_TIMEOUT_MS=20000
